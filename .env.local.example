# Google Gemini API キー (https://aistudio.google.com/apikey で取得)
GEMINI_API_KEY=your_api_key_here

# 任意: モデルIDを上書きしたい場合（APIの仕様変更に追従するため）
# NANO_BANANA_2_MODEL_ID=gemini-2.5-flash-image
# NANO_BANANA_PRO_MODEL_ID=gemini-3-pro-image-preview

# 任意: OpenAI / Replicate のサーバー側共有キー（未設定ならユーザーのBYOキーを使用）
# OPENAI_API_KEY=sk-...
# REPLICATE_API_TOKEN=r8_...
# 任意: InstantID のモデル/バージョン上書き（既定 zsxkib/instant-id の最新版を自動解決）
# REPLICATE_INSTANTID_MODEL=zsxkib/instant-id
# REPLICATE_INSTANTID_VERSION=<version hash でピン留め>

